{
  "name": "flow-music-mcp",
  "version": "1.0.0",
  "description": "MCP server for Claude to create AI Music Video storyboards from MP3s using Gemini (audio lyrics/timestamps + consistent character/scene image generation) and Google Flow Music (flowmusic.app video generation via Chrome CDP).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "flow-music-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/login.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "google-flow-music",
    "flowmusic",
    "gemini",
    "music-video",
    "storyboard",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "playwright-core": "^1.55.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  }
}
